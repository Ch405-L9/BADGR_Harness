#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR"

if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi

if [[ $# -eq 0 ]]; then
  echo 'Usage: badgr "your goal here" [--debug]' >&2
  exit 2
fi

DEBUG=()
if [[ "${!#}" == "--debug" ]]; then
  DEBUG=(--debug)
  set -- "${@:1:$(($#-1))}"
fi

if [[ -x .venv/bin/python ]]; then
  PYTHON=.venv/bin/python
else
  PYTHON=python3
fi

exec "$PYTHON" orchestrator.py --goal "$*" "${DEBUG[@]}"
